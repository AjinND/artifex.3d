# Copy this file to .env.local for local development. Leave unused features blank.
# Set production values through the host's environment or secret manager.
# Never put an application secret in a NEXT_PUBLIC_ variable.

# Core: MongoDB must be a replica set for transactional flows.
MONGODB_URI=
APP_ORIGIN=http://localhost:3000

# Public contact and policies. All four are required for live Razorpay checkout.
BUSINESS_EMAIL=
SHIPPING_POLICY=
REFUND_POLICY=
PRIVACY_POLICY=

# Staff access and account recovery. JWT_SECRET is legacy and is not used.
STAFF_EMAIL=
STAFF_TOTP_SECRET=
RECOVERY_SECRET=

# Checkout: comma-separated six-digit PINs, integer basis points, integer paise.
# Use test Razorpay credentials outside production. Pricing has no default.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SERVICEABLE_PINS=
TAX_BASIS_POINTS=
SHIPPING_PAISE=

# Cloud storage: separate catalog and versioned private upload buckets.
# The AWS SDK uses its credential provider chain. Prefer a role on the host.
AWS_REGION=
CATALOG_MEDIA_BUCKET=
PRIVATE_UPLOAD_BUCKET=

# Optional read-only catalog media directory; defaults to public/catalog.
CATALOG_MEDIA_DIR=

# Local storage: use explicit absolute paths and loopback HTTP + MongoDB on 127.0.0.1.
# Examples: E:/Projects/artifex3d/.local/catalog-media and .local/quote-attachments
# under the same absolute project path. Keep private attachments outside public/.
LOCAL_CATALOG_MEDIA_DIR=
LOCAL_UPLOAD_DIR=
# Optional Windows Defender MpCmdRun.exe override; auto-detected when blank.
LOCAL_UPLOAD_SCANNER=

# Worker email delivery. SMTP_URL may contain a password.
SMTP_URL=
MAIL_FROM=
STUDIO_INBOX=

# Optional shell variables for test/seed commands. See LAUNCH.md.
# CHROME_PATH=
# TEST_LOCAL_UPLOAD_SCANNER=
# FIXTURE_MONGODB_URI=
